#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/vpn-manager -config /etc/vpn-manager/config.json -managed-update
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 15
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param env XRAY_LOCATION_ASSET=/usr/share/xray GOGC=50 GOMEMLIMIT=32MiB
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger firewall network
}

reload_service() {
    stop
    start
}
