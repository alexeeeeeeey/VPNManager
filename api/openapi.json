            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "refreshHours": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "refreshHours",
          "updatedAt",
          "error"
        ]
      },
      "Inventory": {
