            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          },
          "subscriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subscription"
            }
          }
        },
        "required": [
          "profiles",
          "subscriptions"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "uptime": {
            "type": "integer"
          },
          "cpu": {
            "type": "integer"
          },
          "memoryUsed": {
            "type": "integer"
          },
          "memoryTotal": {
            "type": "integer"
          },
          "rxBytes": {
            "type": "integer"
          },
          "txBytes": {
            "type": "integer"
          },
          "xrayRxBytes": {
            "type": "integer"
          },
          "xrayTxBytes": {
            "type": "integer"
          },
          "xray": {
            "type": "string"
          },
          "xrayEnabled": {
            "type": "boolean"
          },
          "activeId": {
            "type": "string"
          },
          "restarts": {
            "type": "integer"
          },
          "tproxy": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "sampledAt": {
            "type": "string"
          }
        },
        "required": [
          "hostname",
          "uptime",
          "cpu",
          "memoryUsed",
          "memoryTotal",
          "rxBytes",
          "txBytes",
          "xrayRxBytes",
          "xrayTxBytes",
          "xray",
          "xrayEnabled",
          "activeId",
          "restarts",
          "tproxy",
          "message"
